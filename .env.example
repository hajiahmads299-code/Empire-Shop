# Empire Shop production/development environment template
# Copy to .env.local for local development. Configure these values in Vercel Project Settings for production.

# Required in every non-development deployment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Required in production for canonical URLs, CORS, metadata, emails, and payments
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Optional but strongly recommended on Vercel/multi-instance deployments
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
API_RATE_LIMIT="300"
API_RATE_WINDOW_MS="60000"

# ATOMA Pay / hosted checkout
ATOMA_PAY_BASE_URL="https://api.atomapay.com"
ATOMA_PAY_MERCHANT_ID=""
ATOMA_PAY_API_KEY=""
ATOMA_PAY_WEBHOOK_SECRET=""
ATOMA_PAY_PUBLIC_BASE_URL=""

# Vercel Blob token for durable production uploads (recommended for marketplace media)
BLOB_READ_WRITE_TOKEN=""

# Email / SMS integrations (optional unless verification/reset delivery is enabled)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Development/test escape hatch only. Never enable in production.
ALLOW_MOCK_AUTH="false"
